{
  "id": null,
  "uid": "srcds-server-stats",
  "title": "SRCDS Server Stats",
  "description": "Per-server and system metrics exported by gmsv_serverstat",
  "tags": ["srcds", "serverstat", "gmod"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      },
      {
        "name": "instance",
        "label": "Server",
        "type": "query",
        "datasource": { "uid": "${datasource}" },
        "query": "label_values(srcds_process_cpu_usage, instance)",
        "multi": true,
        "includeAll": true,
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "refresh": 2,
        "hide": 0
      }
    ]
  },
  "panels": [

    {
      "title": "Per-Server Metrics",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },

    {
      "title": "Players",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 0, "y": 1 },
      "datasource": { "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": { "mode": "fixed", "fixedColor": "blue" }
        }
      },
      "targets": [{
        "expr": "srcds_player_count{instance=~\"$instance\"}",
        "legendFormat": "{{instance}}"
      }]
    },
    {
      "title": "Process CPU",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 3, "y": 1 },
      "datasource": { "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": { "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 0.5 },
            { "color": "red", "value": 0.8 }
          ]}
        }
      },
      "targets": [{
        "expr": "srcds_process_cpu_usage{instance=~\"$instance\"}",
        "legendFormat": "{{instance}}"
      }]
    },
    {
      "title": "Process Memory",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 6, "y": 1 },
      "datasource": { "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "decmbytes",
          "thresholds": { "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 1024 },
            { "color": "red", "value": 2048 }
          ]}
        }
      },
      "targets": [{
        "expr": "srcds_process_memory_mib{instance=~\"$instance\"}",
        "legendFormat": "{{instance}}"
      }]
    },
    {
      "title": "Lua Memory",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 9, "y": 1 },
      "datasource": { "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "deckbytes",
          "thresholds": { "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 65536 },
            { "color": "red", "value": 131072 }
          ]}
        }
      },
      "targets": [{
        "expr": "srcds_lua_memory_kib{instance=~\"$instance\"}",
        "legendFormat": "{{instance}}"
      }]
    },
    {
      "title": "Threads",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 12, "y": 1 },
      "datasource": { "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": { "mode": "fixed", "fixedColor": "purple" }
        }
      },
      "targets": [{
        "expr": "srcds_process_thread_count{instance=~\"$instance\"}",
        "legendFormat": "{{instance}}"
      }]
    },
    {
      "title": "Uptime",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 15, "y": 1 },
      "datasource": { "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "fixed", "fixedColor": "green" }
        }
      },
      "targets": [{
        "expr": "srcds_process_uptime_seconds{instance=~\"$instance\"}",
        "legendFormat": "{{instance}}"
      }]
    },
    {
      "title": "Disk Read",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 18, "y": 1 },
      "datasource": { "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "decbytes",
          "color": { "mode": "fixed", "fixedColor": "orange" }
        }
      },
      "targets": [{
        "expr": "srcds_process_disk_read_bytes{instance=~\"$instance\"}",
        "legendFormat": "{{instance}}"
      }]
    },
    {
      "title": "Disk Written",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 21, "y": 1 },
      "datasource": { "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "decbytes",
          "color": { "mode": "fixed", "fixedColor": "orange" }
        }
      },
      "targets": [{
        "expr": "srcds_process_disk_write_bytes{instance=~\"$instance\"}",
        "legendFormat": "{{instance}}"
      }]
    },

    {
      "title": "Player Count",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 5 },
      "datasource": { "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "custom": { "fillOpacity": 15, "drawStyle": "line", "pointSize": 5, "showPoints": "auto" }
        }
      },
      "targets": [{
        "expr": "srcds_player_count{instance=~\"$instance\"}",
        "legendFormat": "{{instance}}"
      }]
    },
    {
      "title": "Process CPU (over time)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 5 },
      "datasource": { "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": { "fillOpacity": 15 }
        }
      },
      "targets": [{
        "expr": "srcds_process_cpu_usage{instance=~\"$instance\"}",
        "legendFormat": "{{instance}}"
      }]
    },
    {
      "title": "Process Memory (over time)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 5 },
      "datasource": { "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "decmbytes",
          "custom": { "fillOpacity": 15 }
        }
      },
      "targets": [{
        "expr": "srcds_process_memory_mib{instance=~\"$instance\"}",
        "legendFormat": "{{instance}}"
      }]
    },

    {
      "title": "Lua Memory (over time)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 13 },
      "datasource": { "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "deckbytes",
          "custom": { "fillOpacity": 15 }
        }
      },
      "targets": [{
        "expr": "srcds_lua_memory_kib{instance=~\"$instance\"}",
        "legendFormat": "{{instance}}"
      }]
    },
    {
      "title": "Disk I/O Rate",
      "description": "Per-second disk read/write rate (derived from cumulative counters)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 13 },
      "datasource": { "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": { "fillOpacity": 15 }
        }
      },
      "targets": [
        {
          "expr": "rate(srcds_process_disk_read_bytes{instance=~\"$instance\"}[5m])",
          "legendFormat": "read {{instance}}"
        },
        {
          "expr": "rate(srcds_process_disk_write_bytes{instance=~\"$instance\"}[5m])",
          "legendFormat": "write {{instance}}"
        }
      ]
    },
    {
      "title": "Thread Count (over time)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 13 },
      "datasource": { "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "custom": { "fillOpacity": 10 }
        }
      },
      "targets": [{
        "expr": "srcds_process_thread_count{instance=~\"$instance\"}",
        "legendFormat": "{{instance}}"
      }]
    },

    {
      "title": "System Metrics (shared across servers on the same host)",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 21 },
      "collapsed": false
    },

    {
      "title": "System CPU",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 22 },
      "datasource": { "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": { "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 60 },
            { "color": "red", "value": 85 }
          ]}
        }
      },
      "targets": [{
        "expr": "srcds_system_cpu_usage{instance=~\"$instance\"}",
        "legendFormat": "{{instance}}"
      }]
    },
    {
      "title": "System Memory %",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 22 },
      "datasource": { "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": { "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 60 },
            { "color": "red", "value": 85 }
          ]}
        }
      },
      "targets": [{
        "expr": "srcds_system_memory_used_mib{instance=~\"$instance\"} / srcds_system_memory_total_mib{instance=~\"$instance\"} * 100",
        "legendFormat": "{{instance}}"
      }]
    },
    {
      "title": "Swap Used",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 22 },
      "datasource": { "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "decmbytes",
          "thresholds": { "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 512 },
            { "color": "red", "value": 2048 }
          ]}
        }
      },
      "targets": [{
        "expr": "srcds_system_swap_used_mib{instance=~\"$instance\"}",
        "legendFormat": "{{instance}}"
      }]
    },
    {
      "title": "CPU Cores / RAM / Swap",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 22 },
      "datasource": { "uid": "${datasource}" },
      "options": {
        "textMode": "value_and_name",
        "colorMode": "background",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "purple" }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": ".*cores.*" },
            "properties": [{ "id": "unit", "value": "none" }]
          },
          {
            "matcher": { "id": "byRegexp", "options": ".*RAM.*|.*swap.*" },
            "properties": [{ "id": "unit", "value": "decmbytes" }]
          }
        ]
      },
      "targets": [
        {
          "expr": "srcds_logical_cpus{instance=~\"$instance\"}",
          "legendFormat": "cores {{instance}}"
        },
        {
          "expr": "srcds_system_memory_total_mib{instance=~\"$instance\"}",
          "legendFormat": "RAM {{instance}}"
        },
        {
          "expr": "srcds_system_swap_total_mib{instance=~\"$instance\"}",
          "legendFormat": "swap {{instance}}"
        }
      ]
    },
    {
      "title": "System CPU (over time)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 26 },
      "datasource": { "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": { "fillOpacity": 15 }
        }
      },
      "targets": [{
        "expr": "srcds_system_cpu_usage{instance=~\"$instance\"}",
        "legendFormat": "{{instance}}"
      }]
    },
    {
      "title": "System Memory (over time)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 26 },
      "datasource": { "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "decmbytes",
          "custom": { "fillOpacity": 15 }
        }
      },
      "targets": [
        {
          "expr": "srcds_system_memory_used_mib{instance=~\"$instance\"}",
          "legendFormat": "used {{instance}}"
        },
        {
          "expr": "srcds_system_swap_used_mib{instance=~\"$instance\"}",
          "legendFormat": "swap {{instance}}"
        }
      ]
    }
  ],
  "schemaVersion": 37,
  "version": 1
}
